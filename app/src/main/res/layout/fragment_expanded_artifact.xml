<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/buttonRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageButton
                    android:id="@+id/buttonReturn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/back"
                    android:scaleType="centerInside"
                    android:background="@drawable/rounded_corner"
                    app:tint="#F4F5F6"
                    android:contentDescription="@string/return_to_home"
                    android:padding="10dp" />

                <ImageButton
                    android:id="@+id/buttonSave"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/bookmark"
                    android:scaleType="centerInside"
                    android:background="@drawable/rounded_corner"
                    app:tint="#F4F5F6"
                    android:contentDescription="@string/save_artifact"
                    android:padding="10dp" />

                <ImageButton
                    android:id="@+id/buttonComment"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/comment"
                    android:scaleType="centerInside"
                    android:background="@drawable/rounded_corner"
                    app:tint="#F4F5F6"
                    android:contentDescription="@string/comment_section"
                    android:padding="10dp" />

                <ImageButton
                    android:id="@+id/buttonLike"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/temporary_asset"
                    android:scaleType="centerInside"
                    android:background="@drawable/rounded_corner"
                    app:tint="#F4F5F6"
                    android:contentDescription="@string/like_artifact"
                    android:padding="10dp" />

                <ImageButton
                    android:id="@+id/buttonEdit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/edit"
                    android:scaleType="centerInside"
                    android:background="@drawable/rounded_corner"
                    app:tint="#F4F5F6"
                    android:contentDescription="@string/edit_artifact"
                    android:padding="10dp" />

                <ImageButton
                    android:id="@+id/buttonDelete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/delete"
                    android:scaleType="centerInside"
                    android:background="@drawable/rounded_corner"
                    app:tint="#F4F5F6"
                    android:contentDescription="@string/delete_artifact"
                    android:padding="10dp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/expandedImage"
                android:layout_width="0dp"
                android:layout_height="240dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="#424242"
                app:layout_constraintTop_toBottomOf="@id/buttonRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#00BCD4"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/expandedImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#E0E0E0"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedLot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/expandedDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedLot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedMaterial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedCategory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedDynasty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedMaterial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedCulturalOrigin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedDynasty"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedDimensions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedCulturalOrigin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedCondition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedDimensions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedCurrentLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedCondition"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedAcquisitionMethod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedCurrentLocation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedProvenance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedAcquisitionMethod"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedAccessionNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/expandedProvenance"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/expandedNotes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/expandedAccessionNumber"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>